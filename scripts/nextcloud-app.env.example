# Copy to scripts/nextcloud-app.env and adjust as needed.
# scripts/nextcloud-app.env is gitignored.

# Where backups are stored (absolute or relative to repo root)
BACKUP_DIR=../nextcloud-backups

# Run backup --if-due only when last backup is at least this many days old
BACKUP_INTERVAL_DAYS=30

# Keep the newest N backup folders (older ones are deleted after a successful backup)
BACKUP_KEEP=3

# Compose file relative to the repo root (AIO ships compose.yaml)
COMPOSE_FILE=compose.yaml

# Host port for the AIO admin UI (HTTPS, self-signed). Bound to 127.0.0.1; LAN via proxy.
AIO_PORT=8080

# Host port for Nextcloud itself (AIO reverse-proxy / APACHE_PORT). Bound to 127.0.0.1; LAN via proxy.
APACHE_PORT=11000

# Host directory for Nextcloud files (must be set before first install; do not change later)
NEXTCLOUD_DATADIR=../nextcloud-data

# Skip AIO public-domain checks so a local / LAN install can proceed
SKIP_DOMAIN_VALIDATION=true

# On update: also pull nextcloud/all-in-one upstream into the current branch (merge)
UPDATE_SYNC_ON_UPDATE=true
